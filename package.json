{
    "name": "uvo-frontend",
    "description": "UvO Amsterdam Website",
    "version": "0.2.0",
    "license": "UNLICENSED",
    "private": true,
    "engines": {
        "node": ">=25",
        "pnpm": ">=10"
    },
    "packageManager": "pnpm@10.28.0",
    "type": "module",
    "repository": {
        "type": "git",
        "directory": "/",
        "url": "https://github.com/uvo-amsterdam/uvo-frontend.git"
    },
    "scripts": {
        "clean": "rimraf .next node_modules coverage .swc",
        "postinstall": "husky",
        "dev": "next dev --turbopack",
        "build": "next build",
        "start": "next start",
        "lint": "next lint",
        "----- Lint & Format -----": "-----",
        "format": "biome check . --fix",
        "format-n-lint": "biome check . && stylelint **/*.scss",
        "format-n-lint:fix": "biome check . --fix && stylelint **/*.scss --fix",
        "format-n-lint:ci": "biome ci --error-on-warnings && stylelint \"**/*.{css,scss,sass}\"",
        "pre-commit": "pnpm format-n-lint:fix"
    },
    "dependencies": {
        "@biomejs/biome": "2.4.4",
        "@radix-ui/themes": "3.3.0",
        "@react-pdf-viewer/core": "3.12.0",
        "@react-pdf-viewer/default-layout": "3.12.0",
        "@tabler/icons-react": "3.37.1",
        "fs-extra": "^11.3.3",
        "husky": "9.1.7",
        "next": "16.1.6",
        "pdfjs-dist": "5.4.296",
        "react": "19.2.4",
        "react-dom": "19.2.4",
        "react-pdf": "^10.4.1",
        "rimraf": "6.1.3",
        "sass": "1.97.3",
        "stylelint": "17.4.0"
    },
    "devDependencies": {
        "@changesets/cli": "2.29.8",
        "@types/fs-extra": "^11.0.4",
        "@types/node": "25.3.0",
        "@types/react": "19.2.14",
        "@types/react-dom": "19.2.3",
        "csstype": "3.2.3",
        "lint-staged": "16.2.7",
        "stylelint-config-standard-scss": "17.0.0",
        "typescript": "5.9.3"
    },
    "lint-staged": {
        "*.{css,scss,sass}": "stylelint --fix",
        "*.{js,cjs,mjs,jsx,ts,tsx,graphql,json,jsonc}": "biome check --fix --files-ignore-unknown=true --no-errors-on-unmatched"
    }
}
